# =============================================================================
# Badminton Live — Environment Variable Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER & DEPLOYMENT CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
HTTP_PORT=80

# CORS Allowed Origin
# For local development: http://localhost:5173 or http://localhost
# For Vercel single-project deployment: leave as your production domain or https://your-domain.vercel.app
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Managed PostgreSQL on Neon/Supabase/Vercel)
# -----------------------------------------------------------------------------
POSTGRES_DB=badminton_live
POSTGRES_USER=badminton
POSTGRES_PASSWORD=change_this_in_production_super_secret_pass
POSTGRES_PORT=5432
DATABASE_URL=postgresql://badminton:change_this_in_production_super_secret_pass@localhost:5432/badminton_live?schema=public

# -----------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS (Required in Production)
# -----------------------------------------------------------------------------
JWT_SECRET=production_jwt_secret_key_badminton_live_super_secure_99
JWT_REFRESH_SECRET=production_jwt_refresh_secret_key_badminton_live_super_secure_99
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# 4. INITIAL SUPER ADMIN SEED CREDENTIALS
# -----------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@badminton.live
SEED_SUPER_ADMIN_PASSWORD=AdminPassword123!
SEED_SUPER_ADMIN_NAME=System Super Admin

# -----------------------------------------------------------------------------
# 5. FRONTEND VITE ENVIRONMENT VARIABLES (Optional for Single Project Deployment)
# Leave blank on Vercel for automatic same-origin API & Socket connection.
# -----------------------------------------------------------------------------
# VITE_API_URL=
# VITE_SOCKET_URL=
