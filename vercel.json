{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "/api"
    },
    {
      "source": "/socket.io",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|socket.io|health).*)",
      "destination": "/index.html"
    }
  ]
}
