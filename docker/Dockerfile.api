# =============================================================================
# Dockerfile.api — Badminton Live Express API Production Container
# =============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package manifests & lockfiles
COPY package.json package-lock.json ./
COPY packages/database/package.json ./packages/database/
COPY packages/scoring/package.json ./packages/scoring/
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN npm ci

# Copy source files
COPY tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Generate Prisma Client & build workspace packages
RUN npm run build --workspace=packages/database
RUN npm run build --workspace=packages/scoring
RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=apps/api

# Production Runner Stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Copy node_modules & build artifacts from builder
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api

EXPOSE 4000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/health || exit 1

CMD ["node", "apps/api/dist/index.js"]
