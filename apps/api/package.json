{
  "name": "@badminton-live/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express + Socket.IO API server for Badminton Live",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test:phase2": "tsx src/test-phase2.ts",
    "test:phase3": "tsx src/test-phase3.ts",
    "test:phase4": "tsx src/test-phase4.ts",
    "test:phase5": "tsx src/test-phase5-scoring.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@badminton-live/database": "*",
    "@badminton-live/shared": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
