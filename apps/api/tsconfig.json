{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@badminton-live/database": ["../../packages/database/dist/index.d.ts"],
      "@badminton-live/shared": ["../../packages/shared/dist/index.d.ts"],
      "@badminton-live/scoring": ["../../packages/scoring/dist/index.d.ts"]
